{
  "name": "pysx-lang",
  "displayName": "PYSX",
  "description": "PYSX markup highlighting, diagnostics and an optional resident language server for templates inside t-strings",
  "publisher": "pysx-local",
  "icon": "icon.png",
  "version": "0.1.0",
  "scripts": {
    "test": "node test/runner.mjs",
    "setup:host": "node test/setup_host.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "colors": [
      { "id": "pysx.markup.type", "description": "Resolved native markup tags outside literal calls.", "defaults": { "dark": "symbolIcon.keywordForeground", "light": "symbolIcon.keywordForeground", "highContrast": "symbolIcon.keywordForeground" } },
      { "id": "pysx.markup.class", "description": "Resolved markup component tags outside literal calls.", "defaults": { "dark": "symbolIcon.classForeground", "light": "symbolIcon.classForeground", "highContrast": "symbolIcon.classForeground" } },
      { "id": "pysx.markup.property", "description": "Resolved markup attribute names outside literal calls.", "defaults": { "dark": "symbolIcon.propertyForeground", "light": "symbolIcon.propertyForeground", "highContrast": "symbolIcon.propertyForeground" } },
      { "id": "pysx.markup.keyword", "description": "Resolved markup control keywords outside literal calls.", "defaults": { "dark": "symbolIcon.keywordForeground", "light": "symbolIcon.keywordForeground", "highContrast": "symbolIcon.keywordForeground" } },
      { "id": "pysx.markup.variable", "description": "Resolved markup binding names outside literal calls.", "defaults": { "dark": "symbolIcon.variableForeground", "light": "symbolIcon.variableForeground", "highContrast": "symbolIcon.variableForeground" } },
      { "id": "pysx.markup.string", "description": "Resolved markup quoted values outside literal calls.", "defaults": { "dark": "symbolIcon.stringForeground", "light": "symbolIcon.stringForeground", "highContrast": "symbolIcon.stringForeground" } }
    ],
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/python.json"
      }
    ],
    "commands": [
      {
        "command": "pysx.rename",
        "title": "PYSX: Rename Python and Markup Symbol"
      },
      {
        "command": "pysx.refresh",
        "title": "PYSX: Refresh Analysis"
      },
      {
        "command": "pysx.configureTooling",
        "title": "PYSX: Configure Template-Aware Imports"
      },
      {
        "command": "pysx.restartServer",
        "title": "PYSX: Restart Language Server"
      },
      {
        "command": "pysx.restoreTooling",
        "title": "PYSX: Restore Editor Settings PYSX Changed"
      }
    ],
    "keybindings": [
      {
        "command": "pysx.rename",
        "key": "f2",
        "when": "editorTextFocus && pysx.managedDocument"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pysx.rename",
          "when": "editorLangId == python",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "PYSX",
      "properties": {
        "pysx.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Python 3.14+ executable with PYSX and Ruff installed."
        },
        "pysx.useLanguageServer": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Use the resident PYSX language server instead of the worker integration. Requires the pysx[lsp] extra in the selected environment."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "source.pysx.injection",
        "path": "./syntaxes/pysx.injection.tmLanguage.json",
        "injectTo": [
          "source.python"
        ]
      }
    ],
    "configurationDefaults": {
      "files.exclude": {
        "**/_pysx_revision_*": true
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "support.function.css.pysx",
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "scope": "support.constant.property-value.css.pysx",
            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "scope": "support.class.component.pysx",
            "settings": {
              "foreground": "#4EC9B0",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.tag.pysx",
            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "scope": "keyword.control.conditional.pysx",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "scope": "entity.other.attribute-name.pysx",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "scope": "keyword.operator.assignment.pysx",
            "settings": {
              "foreground": "#D4D4D4"
            }
          },
          {
            "scope": "string.quoted.double.pysx",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "scope": "punctuation.definition.string.begin.pysx,punctuation.definition.string.end.pysx",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "scope": "punctuation.definition.tag.begin.pysx,punctuation.definition.tag.end.pysx",
            "settings": {
              "foreground": "#808080"
            }
          },
          {
            "scope": "punctuation.separator.pysx",
            "settings": {
              "foreground": "#808080"
            }
          },
          {
            "scope": "punctuation.section.block.pysx",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "scope": "punctuation.terminator.pysx",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "scope": "punctuation.section.embedded.begin.pysx,punctuation.section.embedded.end.pysx",
            "settings": {
              "foreground": "#D7BA7D"
            }
          }
        ]
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:python"
  ],
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  }
}

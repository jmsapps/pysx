{
  "name": "pysx-lang",
  "displayName": "pysx",
  "description": "pysx markup highlighting and diagnostics inside t-strings",
  "publisher": "pysx-local",
  "version": "0.0.1",
  "scripts": { "test": "node test/runner.mjs", "setup:host": "node test/setup_host.mjs" },
  "devDependencies": { "@vscode/test-electron": "3.1.0" },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "snippets": [{ "language": "python", "path": "./snippets/python.json" }],
    "commands": [
      { "command": "pysx.rename", "title": "pysx: Rename Python and Markup Symbol" },
      { "command": "pysx.refresh", "title": "pysx: Refresh Analysis" },
      { "command": "pysx.configureTooling", "title": "pysx: Configure Template-Aware Imports" }
    ],
    "keybindings": [
      { "command": "pysx.rename", "key": "f2", "when": "editorTextFocus && pysx.managedDocument" }
    ],
    "menus": { "editor/context": [
      { "command": "pysx.rename", "when": "editorLangId == python", "group": "1_modification" }
    ] },
    "configuration": {
      "title": "pysx",
      "properties": {
        "pysx.pythonPath": { "type": "string", "default": "", "scope": "resource", "description": "Python 3.14+ executable with pysx and Ruff installed." }
      }
    },
    "grammars": [
      {
        "scopeName": "source.pysx.injection",
        "path": "./syntaxes/pysx.injection.tmLanguage.json",
        "injectTo": [
          "source.python"
        ]
      }
    ],
    "configurationDefaults": {
      "files.exclude": { "**/_pysx_revision_*": true },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "support.function.css.pysx",
            "settings": { "foreground": "#DCDCAA" }
          },
          {
            "scope": "support.constant.property-value.css.pysx",
            "settings": { "foreground": "#569CD6" }
          },
          {
            "scope": "support.class.component.pysx",
            "settings": {
              "foreground": "#4EC9B0",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.tag.pysx",
            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "scope": "keyword.control.conditional.pysx",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "scope": "entity.other.attribute-name.pysx",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "scope": "keyword.operator.assignment.pysx",
            "settings": {
              "foreground": "#D4D4D4"
            }
          },
          {
            "scope": "string.quoted.double.pysx",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "scope": "punctuation.definition.string.begin.pysx,punctuation.definition.string.end.pysx",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "scope": "punctuation.definition.tag.begin.pysx,punctuation.definition.tag.end.pysx",
            "settings": {
              "foreground": "#808080"
            }
          },
          {
            "scope": "punctuation.separator.pysx",
            "settings": {
              "foreground": "#808080"
            }
          },
          {
            "scope": "punctuation.section.block.pysx",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "scope": "punctuation.terminator.pysx",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "scope": "punctuation.section.embedded.begin.pysx,punctuation.section.embedded.end.pysx",
            "settings": {
              "foreground": "#D7BA7D"
            }
          }
        ]
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:python"
  ]
}

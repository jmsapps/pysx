{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "pysx markup in t-strings",
  "scopeName": "source.pysx.injection",
  "injectionSelector": "L:source.python -string -comment",
  "patterns": [
    {
      "include": "#css-extension"
    },
    {
      "include": "#css-call"
    },
    {
      "include": "#pysx-call"
    }
  ],
  "repository": {
    "css-extension": {
      "name": "meta.function-call.python",
      "begin": "\\b(styled)\\s*\\(\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*\\)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.python"
        },
        "2": {
          "name": "variable.other.readwrite.python"
        },
        "3": {
          "name": "punctuation.section.arguments.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.python"
        }
      },
      "patterns": [
        {
          "include": "#css-template"
        },
        {
          "include": "#css-mapping"
        },
        {
          "include": "source.python"
        }
      ]
    },
    "css-call": {
      "name": "meta.function-call.python",
      "begin": "\\b(styled|css|global_style)(?:\\.[A-Za-z_][A-Za-z0-9_]*)?\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.python"
        },
        "2": {
          "name": "punctuation.section.arguments.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.python"
        }
      },
      "patterns": [
        {
          "include": "#css-call"
        },
        {
          "include": "#css-template"
        },
        {
          "include": "#css-string"
        },
        {
          "include": "#css-mapping"
        },
        {
          "include": "source.python"
        }
      ]
    },
    "css-template": {
      "begin": "(t)(\"\"\"|'''|\"|')",
      "end": "\\2",
      "beginCaptures": {
        "1": {
          "name": "storage.type.string.python"
        },
        "2": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.python"
        },
        {
          "include": "#hole"
        },
        {
          "include": "#css-body"
        }
      ]
    },
    "css-string": {
      "begin": "([rR]?)(\"\"\"|'''|\"|')",
      "end": "\\2",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.python"
        },
        {
          "include": "#css-body"
        }
      ]
    },
    "css-body": {
      "patterns": [
        {
          "include": "#css-declaration"
        },
        {
          "match": "@[A-Za-z-]+",
          "name": "keyword.control.at-rule.css"
        },
        {
          "match": "&",
          "name": "entity.other.attribute-name.parent-selector.css"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.css"
        },
        {
          "match": "--[A-Za-z_][A-Za-z0-9_-]*",
          "name": "variable.other.custom-property.css"
        },
        {
          "match": "[A-Za-z][A-Za-z0-9-]*(?=\\s*:)",
          "name": "support.type.property-name.css"
        },
        {
          "match": "\\b[A-Za-z][A-Za-z0-9-]*(?=\\()",
          "name": "support.function.css.pysx"
        },
        {
          "match": "#[A-Fa-f0-9]{3,8}\\b",
          "name": "constant.other.color.rgb-value.css"
        },
        {
          "match": "[0-9]+(?:\\.[0-9]+)?(?:px|rem|em|%|vh|vw)?",
          "name": "constant.numeric.css"
        },
        {
          "match": "[:;{}()]",
          "name": "punctuation.separator.css"
        }
      ]
    },
    "css-declaration": {
      "comment": "Scope identifiers inside declarations, excluding indentation selectors and CSS selector blocks.",
      "begin": "(?:^|\\G|(?<=[;{]))\\s*(?:(--[A-Za-z_][A-Za-z0-9_-]*)|([A-Za-z][A-Za-z0-9-]*))\\s*(:)(?![^;\\n]*:\\s*$|[A-Za-z-]+\\s*\\{)",
      "beginCaptures": {
        "1": { "name": "variable.other.custom-property.css" },
        "2": { "name": "support.type.property-name.css" },
        "3": { "name": "punctuation.separator.css" }
      },
      "end": ";|(?=$|[}\\\"'])",
      "endCaptures": {
        "0": { "name": "punctuation.separator.css" }
      },
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "#hole" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.css" },
        {
          "begin": "\"(?!\"\"|\\s*[,)]|\\s*$)(?=[^\"\\n]*\")",
          "end": "\"|(?=$)",
          "name": "string.quoted.double.css",
          "patterns": [{ "include": "#hole" }, { "match": "\\\\.", "name": "constant.character.escape.css" }]
        },
        {
          "begin": "'(?!''|\\s*[,)]|\\s*$)(?=[^'\\n]*')",
          "end": "'|(?=$)",
          "name": "string.quoted.single.css",
          "patterns": [{ "include": "#hole" }, { "match": "\\\\.", "name": "constant.character.escape.css" }]
        },
        { "match": "--[A-Za-z_][A-Za-z0-9_-]*", "name": "variable.other.custom-property.css" },
        { "match": "\\b[A-Za-z][A-Za-z0-9-]*(?=\\()", "name": "support.function.css.pysx" },
        { "match": "#[A-Fa-f0-9]{3,8}\\b", "name": "constant.other.color.rgb-value.css" },
        { "match": "(?<![A-Za-z0-9_-])-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[A-Za-z]+|%)?", "name": "constant.numeric.css" },
        { "match": "[A-Za-z_][A-Za-z0-9_-]*", "name": "support.constant.property-value.css.pysx" },
        { "match": "[,()]", "name": "punctuation.separator.css" },
        { "match": "\\\\.", "name": "constant.character.escape.python" }
      ]
    },
    "css-attribute": {
      "begin": "\\b(css)\\s*(=)\\s*(\")",
      "end": "\"|(?=$)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.pysx"
        },
        "2": {
          "name": "keyword.operator.assignment.pysx"
        },
        "3": {
          "name": "punctuation.definition.string.begin.pysx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.pysx"
        }
      },
      "contentName": "meta.embedded.inline.css",
      "patterns": [
        {
          "include": "#css-body"
        }
      ]
    },
    "pysx-call": {
      "comment": "Keep call context across lines so formatter-expanded pysx arguments retain markup highlighting.",
      "name": "meta.function-call.python",
      "begin": "\\b(pysx)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.python"
        },
        "2": {
          "name": "punctuation.section.arguments.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.python"
        }
      },
      "patterns": [
        {
          "include": "#pysx-template"
        },
        {
          "include": "source.python"
        }
      ]
    },
    "pysx-template": {
      "begin": "([rR][tT]|[tT][rR]|[tT])(\"\"\"|'''|\"|')",
      "end": "\\2",
      "beginCaptures": {
        "1": {
          "name": "storage.type.string.python"
        },
        "2": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "contentName": "meta.embedded.block.pysx",
      "patterns": [
        {
          "include": "#pysx-body"
        }
      ]
    },
    "pysx-body": {
      "patterns": [
        {
          "include": "#hole"
        },
        {
          "include": "#loop-header"
        },
        {
          "include": "#local-binding"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#element"
        },
        {
          "include": "#element-html"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#text-string"
        },
        {
          "include": "#text-string-single"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "hole": {
      "comment": "Python expression hole; body is handed back to source.python",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.pysx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.pysx"
        }
      },
      "contentName": "meta.embedded.inline.python",
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    },
    "element": {
      "comment": "Capitalised tag at a row, template-content or inline statement start.",
      "match": "(?:^|\\G|(?<=;))\\s*([A-Z][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "support.class.component.pysx"
        }
      }
    },
    "attributes": {
      "begin": "\\(",
      "end": "\\)|(?=\"\"\"|\\'\\'\\')",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tag.begin.pysx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.pysx"
        }
      },
      "patterns": [
        {
          "include": "#css-attribute"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_-]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.pysx"
            },
            "2": {
              "name": "keyword.operator.assignment.pysx"
            }
          }
        },
        {
          "include": "#hole"
        },
        {
          "include": "#text-string"
        },
        {
          "include": "#text-string-single"
        },
        {
          "match": ",",
          "name": "punctuation.separator.pysx"
        }
      ]
    },
    "text-string": {
      "name": "string.quoted.double.pysx",
      "begin": "\"",
      "end": "(?=\"\"\"|''')|\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.pysx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.pysx"
        }
      },
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.pysx"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ":",
          "name": "punctuation.section.block.pysx"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.pysx"
        }
      ]
    },
    "local-binding": {
      "match": "^\\s*(let|set)\\s+([A-Za-z_][A-Za-z0-9_-]*)\\s*(=)",
      "captures": {
        "1": { "name": "keyword.control.conditional.pysx" },
        "2": { "name": "variable.other.readwrite.pysx" },
        "3": { "name": "keyword.operator.assignment.pysx" }
      }
    },
    "loop-header": {
      "begin": "^\\s*(for)\\b",
      "end": "(?=:)",
      "beginCaptures": {
        "1": { "name": "keyword.control.conditional.pysx" }
      },
      "patterns": [
        { "include": "#hole" },
        {
          "match": "\\b(in)\\b|\\b(key)\\s*(=)",
          "captures": {
            "1": { "name": "keyword.control.loop.pysx" },
            "2": { "name": "keyword.control.loop.pysx" },
            "3": { "name": "keyword.operator.assignment.pysx" }
          }
        },
        { "match": "\\b[A-Za-z_][A-Za-z0-9_-]*\\b", "name": "variable.other.readwrite.pysx" },
        { "match": "[(),]", "name": "punctuation.separator.pysx" }
      ]
    },
    "keyword": {
      "comment": "Positioned branches, loops, matching and local statements.",
      "match": "^\\s*(if|elif|else|for|match|case|let|set|discard)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.conditional.pysx"
        }
      }
    },
    "element-html": {
      "comment": "Native or lowercase callable name at a row, template-content or inline statement start; keyword exclusions retain line-based controls.",
      "match": "(?:^|\\G|(?<=;))\\s*(?!if\\b|elif\\b|else\\b|for\\b|match\\b|case\\b|let\\b|set\\b|discard\\b)([a-z_][A-Za-z0-9_-]*)\\b",
      "captures": {
        "1": {
          "name": "entity.name.tag.pysx"
        }
      }
    },
    "css-mapping": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#css-template"
        },
        {
          "include": "#css-mapping"
        },
        {
          "include": "source.python"
        }
      ]
    },
    "text-string-single": {
      "name": "string.quoted.single.pysx",
      "begin": "'",
      "end": "(?=\"\"\"|''')|'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.pysx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.pysx"
        }
      },
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.pysx"
        }
      ]
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "pysx markup in t-strings",
  "scopeName": "source.pysx.injection",
  "injectionSelector": "L:source.python -string -comment",
  "patterns": [
    { "include": "#css-call" },
    {
      "include": "#pysx-call"
    }
  ],
  "repository": {
    "css-call": {
      "name": "meta.function-call.python",
      "begin": "\\b(styled|css|global_style)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.python" },
        "2": { "name": "punctuation.section.arguments.begin.python" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.arguments.end.python" } },
      "patterns": [
        { "include": "#css-call" },
        { "include": "#css-template" },
        { "include": "#css-string" },
        { "include": "source.python" }
      ]
    },
    "css-template": {
      "begin": "(t)(\"\"\"|'''|\"|')",
      "end": "\\2",
      "beginCaptures": {
        "1": { "name": "storage.type.string.python" },
        "2": { "name": "punctuation.definition.string.begin.python" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.python" } },
      "contentName": "meta.embedded.block.css",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.python" },
        { "include": "#hole" },
        { "include": "#css-body" }
      ]
    },
    "css-string": {
      "begin": "([rR]?)(\"\"\"|'''|\"|')",
      "end": "\\2",
      "beginCaptures": { "2": { "name": "punctuation.definition.string.begin.python" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.python" } },
      "contentName": "meta.embedded.block.css",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.python" },
        { "include": "#css-body" }
      ]
    },
    "css-body": {
      "patterns": [
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.css" },
        { "match": "--[A-Za-z_][A-Za-z0-9_-]*", "name": "variable.other.custom-property.css" },
        { "match": "[A-Za-z][A-Za-z0-9-]*(?=\\s*:)", "name": "support.type.property-name.css" },
        { "match": "\\b[A-Za-z][A-Za-z0-9-]*(?=\\()", "name": "support.function.css.pysx" },
        { "match": "\\b(?:solid|dashed|dotted|double|groove|ridge|inset|outset|none|hidden|auto|inherit|initial|unset|revert|revert-layer|block|inline|inline-block|flex|inline-flex|grid|inline-grid|relative|absolute|fixed|sticky|static|normal|bold|italic|transparent|currentColor)\\b", "name": "support.constant.property-value.css.pysx" },
        { "match": "#[A-Fa-f0-9]{3,8}\\b", "name": "constant.other.color.rgb-value.css" },
        { "match": "[0-9]+(?:\\.[0-9]+)?(?:px|rem|em|%|vh|vw)?", "name": "constant.numeric.css" },
        { "match": "[:;{}()]", "name": "punctuation.separator.css" }
      ]
    },
    "css-attribute": {
      "begin": "\\b(css)\\s*(=)\\s*(\")",
      "end": "\"|(?=$)",
      "beginCaptures": {
        "1": { "name": "entity.other.attribute-name.pysx" },
        "2": { "name": "keyword.operator.assignment.pysx" },
        "3": { "name": "punctuation.definition.string.begin.pysx" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.pysx" } },
      "contentName": "meta.embedded.inline.css",
      "patterns": [{ "include": "#css-body" }]
    },
    "pysx-call": {
      "comment": "Keep call context across lines so formatter-expanded html arguments retain markup highlighting.",
      "name": "meta.function-call.python",
      "begin": "\\b(html)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.python" },
        "2": { "name": "punctuation.section.arguments.begin.python" }
      },
      "endCaptures": { "0": { "name": "punctuation.section.arguments.end.python" } },
      "patterns": [
        { "include": "#pysx-template" },
        { "include": "source.python" }
      ]
    },
    "pysx-template": {
      "begin": "(t)(\"\"\")",
      "end": "(\"\"\")",
      "beginCaptures": {
        "1": {
          "name": "storage.type.string.python"
        },
        "2": {
          "name": "punctuation.definition.string.begin.python"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.python"
        }
      },
      "contentName": "meta.embedded.block.pysx",
      "patterns": [
        {
          "include": "#pysx-body"
        }
      ]
    },
    "pysx-body": {
      "patterns": [
        {
          "include": "#hole"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#element"
        },
        {
          "include": "#element-html"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#text-string"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "hole": {
      "comment": "Python expression hole; body is handed back to source.python",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.pysx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.pysx"
        }
      },
      "contentName": "meta.embedded.inline.python",
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    },
    "element": {
      "comment": "Capitalised tag name at the head of an indented line",
      "match": "^\\s*([A-Z][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "support.class.component.pysx"
        }
      }
    },
    "attributes": {
      "begin": "\\(",
      "end": "\\)|(?=\"\"\")",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tag.begin.pysx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.pysx"
        }
      },
      "patterns": [
        {
          "include": "#css-attribute"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_-]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.pysx"
            },
            "2": {
              "name": "keyword.operator.assignment.pysx"
            }
          }
        },
        {
          "include": "#hole"
        },
        {
          "include": "#text-string"
        },
        {
          "match": ",",
          "name": "punctuation.separator.pysx"
        }
      ]
    },
    "text-string": {
      "name": "string.quoted.double.pysx",
      "begin": "\"",
      "end": "\"|(?=$)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.pysx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.pysx"
        }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "match": ":\\s*$",
          "name": "punctuation.section.block.pysx"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.pysx"
        }
      ]
    },
    "keyword": {
      "comment": "if/else are the only control words in the DSL. elif and match are not grammar; highlighting them would paint tokens the parser rejects.",
      "match": "^\\s*(if|else)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.conditional.pysx"
        }
      }
    },
    "element-html": {
      "comment": "Lowercase tag at the head of an indented line. Deliberately generic: render.py passes any lowercase tag straight through without validation, so the grammar must not claim a fixed set.",
      "match": "^\\s*(?!if\\b|else\\b)([a-z][A-Za-z0-9_-]*)\\b",
      "captures": {
        "1": {
          "name": "entity.name.tag.pysx"
        }
      }
    }
  }
}
